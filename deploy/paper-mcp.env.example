# Copy to deploy/paper-mcp.env (never commit it). See DEPLOYMENT.md for every variable.
PAPER_MCP_URL=https://paper-mcp.example.com
# openssl rand -base64 32 — keep it safe: it decrypts every stored Paper session.
PAPER_MCP_SEAL_KEY=
# Behind the Cloudflare Tunnel: trust CF-Connecting-IP for per-client limits
PAPER_MCP_TRUST_PROXY=cloudflare
# PAPER_MCP_MAX_EDITORS=8
# PAPER_MCP_IDLE_MINUTES=10
# PAPER_MCP_ENV=production
# PAPER_MCP_LOG=info
# TUNNEL_TOKEN=            # only with `--profile tunnel`
